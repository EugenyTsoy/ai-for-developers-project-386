{
  "name": "callbooking",
  "private": true,
  "version": "0.0.0",
  "description": "CallBooking — API contract tooling (TypeSpec → OpenAPI).",
  "scripts": {
    "compile:contract": "tsp compile contract",
    "generate:frontend-types": "openapi-typescript contract/openapi/callbooking.openapi.yaml -o src/frontend/callbooking.web/src/api/generated/schema.d.ts",
    "generate:contract": "node scripts/generate-contract.mjs",
    "verify:contract-drift": "node scripts/verify-contract-drift.mjs"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "openapi-typescript": "7.13.0"
  }
}
