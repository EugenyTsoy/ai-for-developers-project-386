{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "render_create_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "render_trigger_deploy",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "render_update_environment_variables",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "render_select_workspace",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      }
    }
  }
}
